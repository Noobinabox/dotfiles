  ["#tab", "#tab {word}", "Adds or manages tab-completion words."],
  ["#textin", "#textin {file}", "Sends a text file to the active session."],
  ["#ticker", "#ticker {name} {commands} {seconds}", "Runs commands on a repeated timer."],
  ["#time", "#time {format}", "Displays or formats time information."],
  ["#unaction", "#unaction {pattern}", "Removes matching actions."],
  ["#unalias", "#unalias {name}", "Removes matching aliases."],
  ["#unclass", "#unclass {name}", "Removes a class."],
  ["#unfunction", "#unfunction {name}", "Removes matching functions."],
  ["#unvariable", "#unvariable {name}", "Removes matching variables."],
  ["#variable", "#variable {name} {value}", "Sets a variable."],
  ["#while", "#while {expression} {commands}", "Repeats commands while an expression is true."],
  ["#write", "#write {file}", "Writes current settings or lists to a file."],
  ["#zap", "#zap", "Closes the active session."],
].map(([label, detail, documentation]) => ({
  label,
  detail,
  documentation: `${documentation}\n\nSource: https://tintin.mudhalla.net/manual/`,
}));

const numberedSubstitutions = Array.from({ length: 100 }, (_, index) => [
  `%${index}`,
  index === 0 ? "Full trigger match." : `Captured wildcard or pattern argument ${index}.`,
]);

const numberedMetadataSubstitutions = Array.from({ length: 100 }, (_, index) => [
  `&${index}`,
  index === 0 ? "Metadata for the full trigger match." : `Metadata for captured wildcard or pattern argument ${index}.`,
]);

const substitutionDocs = [
  ...numberedSubstitutions,
  ...numberedMetadataSubstitutions,
  ["%*", "All available wildcard or pattern arguments."],
  ["%d", "Digit pattern token."],
  ["%D", "Non-digit pattern token."],
  ["%s", "Whitespace pattern token."],
  ["%S", "Non-whitespace pattern token."],
  ["%w", "Word pattern token."],
  ["%W", "Non-word pattern token."],
].map(([label, documentation]) => ({
  label,
  detail: "TinTin++ substitution",
  documentation: `${documentation}\n\nSource: https://tintin.mudhalla.net/manual/substitutions.php`,
}));

const variableItems = [
  {
    label: "$variable",
    detail: "TinTin++ variable substitution",
    documentation: "Use `$name` to substitute a TinTin++ variable value.",
  },
  {
    label: "&variable",
    detail: "TinTin++ variable metadata substitution",
    documentation: "Use `&name` for variable metadata where supported by TinTin++.",
  },
  {
    label: "*variable",
    detail: "TinTin++ variable index substitution",
    documentation: "Use `*name` for variable index-oriented substitution where supported by TinTin++.",
  },
  {
    label: "@function",
    detail: "TinTin++ function substitution",
    documentation: "Use `@name` to substitute a TinTin++ function result.",
  },
];

function makeCompletionItem(entry, kind) {
  return {
    label: entry.label,
    kind,
    detail: entry.detail,
    documentation: {
      kind: "markdown",
      value: entry.documentation,
    },
  };
}

const completionItems = [
  ...commandDocs.map((entry) => makeCompletionItem(entry, CompletionItemKind.Function)),
  ...substitutionDocs.map((entry) => makeCompletionItem(entry, CompletionItemKind.Keyword)),
  ...variableItems.map((entry) => makeCompletionItem(entry, CompletionItemKind.Variable)),
];

const hoverDocs = new Map([
  ...commandDocs.map((entry) => [entry.label.toLowerCase(), entry]),
  ...substitutionDocs.map((entry) => [entry.label, entry]),
  ...variableItems.map((entry) => [entry.label, entry]),
]);

function send(payload) {
  const body = JSON.stringify(payload);
  process.stdout.write(`Content-Length: ${Buffer.byteLength(body, "utf8")}\r\n\r\n${body}`);
}

function respond(id, result) {
  send({ jsonrpc: "2.0", id, result });
}

function respondError(id, code, message) {
  send({ jsonrpc: "2.0", id, error: { code, message } });
}

function lineAt(text, line) {
  return (text || "").split(/\r?\n/)[line] || "";
}

function tokenAt(line, character) {
  const left = line.slice(0, character + 1);
  const right = line.slice(character + 1);
  const startMatch = left.match(/[#%$&*@]?[A-Za-z0-9_*]*$/);
  const endMatch = right.match(/^[A-Za-z0-9_*]*/);
  return `${startMatch ? startMatch[0] : ""}${endMatch ? endMatch[0] : ""}`;
}

function completionPrefix(line, character) {
  const prefix = line.slice(0, character).match(/[#%$&*@]?[A-Za-z0-9_*]*$/);
  return prefix ? prefix[0].toLowerCase() : "";
}

function completion(params) {
  const text = documents.get(params.textDocument.uri) || "";
  const line = lineAt(text, params.position.line);
  const prefix = completionPrefix(line, params.position.character);

  if (!prefix) {
    return completionItems;
  }

  return completionItems.filter((item) => item.label.toLowerCase().startsWith(prefix));
}

function hover(params) {
  const text = documents.get(params.textDocument.uri) || "";
  const line = lineAt(text, params.position.line);
  const rawToken = tokenAt(line, params.position.character);
  const token = rawToken.startsWith("#") ? rawToken.toLowerCase() : rawToken;

  if (/^\$[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable**\n\nSubstitutes the value of a variable.",
      },
    };
  }

  if (/^&[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable metadata**\n\nSubstitutes variable metadata where supported by TinTin++.",
      },
    };
  }

  if (/^\*[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable index substitution**\n\nSubstitutes variable index data where supported by TinTin++.",
      },
    };
  }

  if (/^@[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ function**\n\nSubstitutes the result of a TinTin++ function.",
      },
    };
  }

  const entry = hoverDocs.get(token);
  if (!entry) {
    return null;
  }

  return {
    contents: {
      kind: "markdown",
      value: `**${entry.label}**\n\n${entry.detail}\n\n${entry.documentation}`,
    },
  };
}

function handleMessage(message) {
  if (message.method === "initialize") {
    respond(message.id, {
      capabilities: {
        textDocumentSync: 1,
        completionProvider: {
          triggerCharacters: ["#", "%", "$", "&", "*", "@"],
        },
        hoverProvider: true,
      },
      serverInfo: {
        name: "tintin-lsp",
        version: "0.1.0",
      },
    });
    return;
  }

  if (message.method === "shutdown") {
    shutdownRequested = true;
    respond(message.id, null);
    return;
  }

  if (message.method === "exit") {
    process.exit(shutdownRequested ? 0 : 1);
  }

  if (message.method === "textDocument/didOpen") {
    documents.set(message.params.textDocument.uri, message.params.textDocument.text || "");
    return;
  }

  if (message.method === "textDocument/didChange") {
    const change = message.params.contentChanges && message.params.contentChanges[0];
    if (change && typeof change.text === "string") {
      documents.set(message.params.textDocument.uri, change.text);
    }
    return;
  }

  if (message.method === "textDocument/didClose") {
    documents.delete(message.params.textDocument.uri);
    return;
  }

  if (message.method === "textDocument/completion") {
    respond(message.id, completion(message.params));
    return;
  }

  if (message.method === "textDocument/hover") {
    respond(message.id, hover(message.params));
    return;
  }

  if (Object.prototype.hasOwnProperty.call(message, "id")) {
    respondError(message.id, -32601, `Method not found: ${message.method}`);
  }
}

function parseBuffer() {
  while (true) {
    const headerEnd = buffer.indexOf("\r\n\r\n");
    if (headerEnd === -1) {
      return;
    }

    const header = buffer.slice(0, headerEnd).toString("utf8");
    const match = header.match(/Content-Length:\s*(\d+)/i);
    if (!match) {
      buffer = buffer.slice(headerEnd + 4);
      continue;
    }

    const length = Number(match[1]);
    const bodyStart = headerEnd + 4;
    const bodyEnd = bodyStart + length;
    if (buffer.length < bodyEnd) {
      return;
    }

    const body = buffer.slice(bodyStart, bodyEnd).toString("utf8");
    buffer = buffer.slice(bodyEnd);

    try {
      handleMessage(JSON.parse(body));
    } catch (error) {
      respondError(null, -32700, error instanceof Error ? error.message : String(error));
    }
  }
}

process.stdin.on("data", (chunk) => {
  buffer = Buffer.concat([buffer, chunk]);
  parseBuffer();
});

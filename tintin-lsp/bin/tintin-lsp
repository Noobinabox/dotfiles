function makeCompletionItem(entry, kind) {
  return {
    label: entry.label,
    kind,
    insertText: entry.label,
    insertTextFormat: 1,
    detail: entry.detail,
    documentation: {
      kind: "markdown",
      value: entry.documentation,
    },
  };
}

const completionItems = [
  ...commandDocs.map((entry) => makeCompletionItem(entry, CompletionItemKind.Keyword)),
  ...substitutionDocs.map((entry) => makeCompletionItem(entry, CompletionItemKind.Keyword)),
  ...variableItems.map((entry) => makeCompletionItem(entry, CompletionItemKind.Variable)),
];


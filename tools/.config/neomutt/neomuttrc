# Copy work-account.example to this separate, unmanaged directory first.
source "~/.config/neomutt-work/account.rc"

set from = $my_work_email
set real_name = $my_work_name
set use_from = yes
set imap_user = $my_work_email
set smtp_user = $my_work_email

# Usernames are supplied separately so @ and other URL characters need no escaping.
set folder = "imaps://outlook.office365.com:993/"
set spool_file = "+INBOX"
set postponed = "+Drafts"
# Exchange Online saves submitted messages in Sent Items itself.
unset record
set smtp_url = "smtp://smtp.office365.com:587/"
set ssl_force_tls = yes
set ssl_starttls = yes
set ssl_verify_host = yes
set ssl_verify_dates = yes

set imap_authenticators = "xoauth2"
set smtp_authenticators = "xoauth2"
set imap_oauth_refresh_command = "bash ~/.config/neomutt/oauth2.sh"
set smtp_oauth_refresh_command = $imap_oauth_refresh_command

set editor = "nvim"
set imap_check_subscribed = yes
set mail_check = 60
set timeout = 15

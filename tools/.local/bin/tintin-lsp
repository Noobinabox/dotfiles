  ["#snoop", "#snoop {session} {on|off}", "Shows or hides another session's output."],
  ["#split", "#split", "Splits the screen into input and output regions."],
  ["#ssl", "#ssl {name} {host} {port} {file}", "Creates a secure SSL session."],
  ["#substitute", "#substitute {pattern} {replacement}", "Substitutes matching incoming text."],
  ["#suspend", "#suspend", "Suspends TinTin++."],
  ["#switch", "#switch {value} {commands}", "Selects a command branch by value."],

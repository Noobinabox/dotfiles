{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#cad3f5",
    "background_color": "#24273a",
    "margin": 2
  },
  "block_quote": {
    "color": "#b8c0e0",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8aadf4",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#24273a",
    "background_color": "#8aadf4",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#f5bde6"
  },
  "h3": {
    "prefix": "### ",
    "color": "#8bd5ca"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#a6da95"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#eed49f"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#ed8796",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#f5bde6"
  },
  "strong": {
    "bold": true,
    "color": "#cad3f5"
  },
  "hr": {
    "color": "#5b6078",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#a6da95",
    "underline": true
  },
  "link_text": {
    "color": "#8bd5ca",
    "bold": true
  },
  "image": {
    "color": "#eed49f",
    "underline": true
  },
  "image_text": {
    "color": "#5b6078",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#eed49f",
    "background_color": "#494d64"
  },
  "code_block": {
    "color": "#cad3f5",
    "background_color": "#24273a",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#cad3f5"
      },
      "error": {
        "color": "#cad3f5",
        "background_color": "#ed8796"
      },
      "comment": {
        "color": "#5b6078",
        "italic": true
      },
      "comment_preproc": {
        "color": "#eed49f"
      },
      "keyword": {
        "color": "#f5bde6"
      },
      "keyword_reserved": {
        "color": "#ed8796"
      },
      "keyword_namespace": {
        "color": "#8aadf4"
      },
      "keyword_type": {
        "color": "#8bd5ca"
      },
      "operator": {
        "color": "#8bd5ca"
      },
      "punctuation": {
        "color": "#8bd5ca"
      },
      "name": {
        "color": "#cad3f5"
      },
      "name_builtin": {
        "color": "#8bd5ca"
      },
      "name_tag": {
        "color": "#ed8796"
      },
      "name_attribute": {
        "color": "#8aadf4"
      },
      "name_class": {
        "color": "#a6da95",
        "bold": true
      },
      "name_constant": {
        "color": "#eed49f"
      },
      "name_decorator": {
        "color": "#eed49f"
      },
      "name_exception": {
        "color": "#ed8796"
      },
      "name_function": {
        "color": "#8aadf4"
      },
      "name_other": {},
      "literal": {
        "color": "#eed49f"
      },
      "literal_number": {
        "color": "#eed49f"
      },
      "literal_date": {
        "color": "#a6da95"
      },
      "literal_string": {
        "color": "#a6da95"
      },
      "literal_string_escape": {
        "color": "#8bd5ca"
      },
      "generic_deleted": {
        "color": "#ed8796"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a6da95"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#5b6078"
      },
      "background": {
        "background_color": "#24273a"
      }
    }
  },
  "table": {
    "color": "#cad3f5"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#8aadf4",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#5b6078"
  },
  "html_span": {
    "color": "#5b6078"
  }
}

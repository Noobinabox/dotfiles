  ["#history", "#history {option} {arguments}", "Inspects or manipulates command history."],
  ["#if", "#if {expression} {commands}", "Runs commands when an expression is true."],
  ["#ignore", "#ignore {on|off}", "Enables or disables command processing for selected lists."],
  ["#info", "#info", "Displays information about sessions, lists, or settings."],
  ["#kill", "#kill", "Removes matching entries from a list."],
  ["#line", "#line {option} {commands}", "Changes how a command line is parsed or executed."],
  ["#list", "#list {variable} {operation} {arguments}", "Creates and manipulates list variables."],
  ["#local", "#local {variable} {value}", "Creates a local variable scoped to the current command block."],
  ["#log", "#log {append|overwrite|off} {file}", "Controls session logging."],
  ["#loop", "#loop {start} {end} {variable} {commands}", "Repeats commands over a numeric range."],
  ["#macro", "#macro {key} {commands}", "Binds commands to a key sequence."],
  ["#map", "#map {option} {arguments}", "Controls TinTin++ mapper features."],
  ["#math", "#math {variable} {expression}", "Evaluates a math expression and stores the result."],
  ["#message", "#message {list} {on|off}", "Controls informational messages."],
  ["#nop", "#nop {comment}", "Comment command; TinTin++ ignores the rest of the command."],
  ["#parse", "#parse {string} {variable} {commands}", "Parses a string and runs commands for matches."],
  ["#path", "#path {option} {arguments}", "Records, manipulates, or plays movement paths."],
  ["#pathdir", "#pathdir {direction} {reverse direction}", "Defines path direction metadata for path tracking."],
  ["#port", "#port {option} {arguments}", "Controls TinTin++ port features."],
  ["#prompt", "#prompt {pattern} {commands}", "Handles prompt lines separately from normal output."],
  ["#read", "#read {file}", "Reads and executes commands from a file."],
  ["#regexp", "#regexp {string} {pattern} {commands}", "Runs commands when a string matches a regular expression."],
  ["#repeat", "#repeat {seconds} {commands}", "Runs commands repeatedly after a delay."],

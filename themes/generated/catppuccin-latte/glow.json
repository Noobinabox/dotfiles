{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#4c4f69",
    "background_color": "#eff1f5",
    "margin": 2
  },
  "block_quote": {
    "color": "#acb0be",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#1e66f5",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#eff1f5",
    "background_color": "#1e66f5",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#8839ef"
  },
  "h3": {
    "prefix": "### ",
    "color": "#179299"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#40a02b"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#df8e1d"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#d20f39",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#8839ef"
  },
  "strong": {
    "bold": true,
    "color": "#4c4f69"
  },
  "hr": {
    "color": "#6c6f85",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#40a02b",
    "underline": true
  },
  "link_text": {
    "color": "#179299",
    "bold": true
  },
  "image": {
    "color": "#fe640b",
    "underline": true
  },
  "image_text": {
    "color": "#8c8fa1",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#fe640b",
    "background_color": "#e6e9ef"
  },
  "code_block": {
    "color": "#4c4f69",
    "background_color": "#dce0e8",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#4c4f69"
      },
      "error": {
        "color": "#4c4f69",
        "background_color": "#d20f39"
      },
      "comment": {
        "color": "#8c8fa1",
        "italic": true
      },
      "comment_preproc": {
        "color": "#df8e1d"
      },
      "keyword": {
        "color": "#8839ef"
      },
      "keyword_reserved": {
        "color": "#d20f39"
      },
      "keyword_namespace": {
        "color": "#1e66f5"
      },
      "keyword_type": {
        "color": "#179299"
      },
      "operator": {
        "color": "#179299"
      },
      "punctuation": {
        "color": "#179299"
      },
      "name": {
        "color": "#4c4f69"
      },
      "name_builtin": {
        "color": "#179299"
      },
      "name_tag": {
        "color": "#d20f39"
      },
      "name_attribute": {
        "color": "#1e66f5"
      },
      "name_class": {
        "color": "#40a02b",
        "bold": true
      },
      "name_constant": {
        "color": "#fe640b"
      },
      "name_decorator": {
        "color": "#df8e1d"
      },
      "name_exception": {
        "color": "#d20f39"
      },
      "name_function": {
        "color": "#1e66f5"
      },
      "name_other": {},
      "literal": {
        "color": "#fe640b"
      },
      "literal_number": {
        "color": "#fe640b"
      },
      "literal_date": {
        "color": "#40a02b"
      },
      "literal_string": {
        "color": "#40a02b"
      },
      "literal_string_escape": {
        "color": "#179299"
      },
      "generic_deleted": {
        "color": "#d20f39"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#40a02b"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#8c8fa1"
      },
      "background": {
        "background_color": "#dce0e8"
      }
    }
  },
  "table": {
    "color": "#4c4f69"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#1e66f5",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#8c8fa1"
  },
  "html_span": {
    "color": "#8c8fa1"
  }
}

#!/usr/bin/env node
"use strict";

const documents = new Map();
let buffer = Buffer.alloc(0);
let shutdownRequested = false;

const CompletionItemKind = {
  Text: 1,
  Function: 3,
  Variable: 6,
  Keyword: 14,
};

const commandDocs = [
  ["#action", "#action {pattern} {commands} {priority}", "Runs commands when incoming text matches a trigger pattern."],
  ["#alias", "#alias {name} {commands}", "Creates a named command alias."],
  ["#all", "#all {commands}", "Runs commands for all active sessions."],
  ["#bell", "#bell", "Rings the terminal bell."],
  ["#break", "#break", "Stops the active loop or switch block."],
  ["#buffer", "#buffer {option} {arguments}", "Inspects or manipulates the scrollback buffer."],
  ["#button", "#button {square} {commands}", "Creates a clickable screen button."],
  ["#case", "#case {value} {commands}", "Adds a case branch inside a switch block."],
  ["#cat", "#cat {file}", "Displays a file locally."],
  ["#chat", "#chat {option} {arguments}", "Controls TinTin++ chat features."],
  ["#class", "#class {name} {open|close|read|write|kill}", "Groups related triggers, aliases, variables, and other settings."],

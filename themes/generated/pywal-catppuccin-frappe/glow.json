{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c6d0f5",
    "background_color": "#303446",
    "margin": 2
  },
  "block_quote": {
    "color": "#b5bfe2",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8caaee",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#303446",
    "background_color": "#8caaee",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#f4b8e4"
  },
  "h3": {
    "prefix": "### ",
    "color": "#81c8be"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#a6d189"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#e5c890"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#e78284",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#f4b8e4"
  },
  "strong": {
    "bold": true,
    "color": "#c6d0f5"
  },
  "hr": {
    "color": "#626880",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#a6d189",
    "underline": true
  },
  "link_text": {
    "color": "#81c8be",
    "bold": true
  },
  "image": {
    "color": "#e5c890",
    "underline": true
  },
  "image_text": {
    "color": "#626880",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e5c890",
    "background_color": "#51576d"
  },
  "code_block": {
    "color": "#c6d0f5",
    "background_color": "#303446",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#c6d0f5"
      },
      "error": {
        "color": "#c6d0f5",
        "background_color": "#e78284"
      },
      "comment": {
        "color": "#626880",
        "italic": true
      },
      "comment_preproc": {
        "color": "#e5c890"
      },
      "keyword": {
        "color": "#f4b8e4"
      },
      "keyword_reserved": {
        "color": "#e78284"
      },
      "keyword_namespace": {
        "color": "#8caaee"
      },
      "keyword_type": {
        "color": "#81c8be"
      },
      "operator": {
        "color": "#81c8be"
      },
      "punctuation": {
        "color": "#81c8be"
      },
      "name": {
        "color": "#c6d0f5"
      },
      "name_builtin": {
        "color": "#81c8be"
      },
      "name_tag": {
        "color": "#e78284"
      },
      "name_attribute": {
        "color": "#8caaee"
      },
      "name_class": {
        "color": "#a6d189",
        "bold": true
      },
      "name_constant": {
        "color": "#e5c890"
      },
      "name_decorator": {
        "color": "#e5c890"
      },
      "name_exception": {
        "color": "#e78284"
      },
      "name_function": {
        "color": "#8caaee"
      },
      "name_other": {},
      "literal": {
        "color": "#e5c890"
      },
      "literal_number": {
        "color": "#e5c890"
      },
      "literal_date": {
        "color": "#a6d189"
      },
      "literal_string": {
        "color": "#a6d189"
      },
      "literal_string_escape": {
        "color": "#81c8be"
      },
      "generic_deleted": {
        "color": "#e78284"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a6d189"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#626880"
      },
      "background": {
        "background_color": "#303446"
      }
    }
  },
  "table": {
    "color": "#c6d0f5"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#8caaee",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#626880"
  },
  "html_span": {
    "color": "#626880"
  }
}

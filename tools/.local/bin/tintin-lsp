  ["#echo", "#echo {text}", "Prints text locally."],
  ["#edit", "#edit {filename}", "Opens a file for editing."],
  ["#else", "#else {commands}", "Fallback branch for an #if or #elseif block."],
  ["#elseif", "#elseif {expression} {commands}", "Conditional branch after an #if block."],
  ["#end", "#end", "Ends a command block."],
  ["#event", "#event {event name} {commands}", "Runs commands when a TinTin++ event fires."],
  ["#foreach", "#foreach {list} {variable} {commands}", "Iterates over each item in a list."],

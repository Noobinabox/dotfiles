{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#24292f",
    "background_color": "#ffffff",
    "margin": 2
  },
  "block_quote": {
    "color": "#f6f8fa",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#0969da",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#ffffff",
    "background_color": "#0969da",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#8250df"
  },
  "h3": {
    "prefix": "### ",
    "color": "#1b7c83"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#116329"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#4d2d00"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#cf222e",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#8250df"
  },
  "strong": {
    "bold": true,
    "color": "#24292f"
  },
  "hr": {
    "color": "#57606a",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#116329",
    "underline": true
  },
  "link_text": {
    "color": "#1b7c83",
    "bold": true
  },
  "image": {
    "color": "#bc4c00",
    "underline": true
  },
  "image_text": {
    "color": "#6e7781",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#bc4c00",
    "background_color": "#f6f8fa"
  },
  "code_block": {
    "color": "#24292f",
    "background_color": "#eaeef2",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#24292f"
      },
      "error": {
        "color": "#24292f",
        "background_color": "#cf222e"
      },
      "comment": {
        "color": "#6e7781",
        "italic": true
      },
      "comment_preproc": {
        "color": "#4d2d00"
      },
      "keyword": {
        "color": "#8250df"
      },
      "keyword_reserved": {
        "color": "#cf222e"
      },
      "keyword_namespace": {
        "color": "#0969da"
      },
      "keyword_type": {
        "color": "#1b7c83"
      },
      "operator": {
        "color": "#1b7c83"
      },
      "punctuation": {
        "color": "#1b7c83"
      },
      "name": {
        "color": "#24292f"
      },
      "name_builtin": {
        "color": "#1b7c83"
      },
      "name_tag": {
        "color": "#cf222e"
      },
      "name_attribute": {
        "color": "#0969da"
      },
      "name_class": {
        "color": "#116329",
        "bold": true
      },
      "name_constant": {
        "color": "#bc4c00"
      },
      "name_decorator": {
        "color": "#4d2d00"
      },
      "name_exception": {
        "color": "#cf222e"
      },
      "name_function": {
        "color": "#0969da"
      },
      "name_other": {},
      "literal": {
        "color": "#bc4c00"
      },
      "literal_number": {
        "color": "#bc4c00"
      },
      "literal_date": {
        "color": "#116329"
      },
      "literal_string": {
        "color": "#116329"
      },
      "literal_string_escape": {
        "color": "#1b7c83"
      },
      "generic_deleted": {
        "color": "#cf222e"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#116329"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#6e7781"
      },
      "background": {
        "background_color": "#eaeef2"
      }
    }
  },
  "table": {
    "color": "#24292f"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#0969da",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#6e7781"
  },
  "html_span": {
    "color": "#6e7781"
  }
}

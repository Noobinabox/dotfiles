const wordPattern = /[A-Za-z0-9_]/;

function send(payload) {
  const body = JSON.stringify(payload);
  process.stdout.write(`Content-Length: ${Buffer.byteLength(body, "utf8")}\r\n\r\n${body}`);
}

function respond(id, result) {
  send({ jsonrpc: "2.0", id, result });
}

function respondError(id, code, message) {
  send({ jsonrpc: "2.0", id, error: { code, message } });
}

function invalidParams(message) {
  throw new LspError(ErrorCodes.InvalidParams, message);
}

function requireObject(value, name) {
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    invalidParams(`Expected ${name}.`);
  }
  return value;
}

function requireString(value, name) {
  if (typeof value !== "string") {
    invalidParams(`Expected ${name} to be a string.`);
  }
  return value;
}

function requirePosition(params) {
  const position = requireObject(params.position, "position");
  if (
    !Number.isInteger(position.line) ||
    !Number.isInteger(position.character) ||
    position.line < 0 ||
    position.character < 0
  ) {
    invalidParams("Expected position.line and position.character to be non-negative integers.");
  }
  return position;
}

function requireTextDocumentUri(params) {
  const textDocument = requireObject(params.textDocument, "textDocument");
  return requireString(textDocument.uri, "textDocument.uri");
}

function requestParams(params) {
  return requireObject(params, "params");
}

function hasRequestId(message) {
  return Object.prototype.hasOwnProperty.call(message, "id");
}

function validateJsonRpcEnvelope(message) {
  if (!message || typeof message !== "object" || Array.isArray(message)) {
    throw new LspError(ErrorCodes.InvalidRequest, "Expected a JSON-RPC request object.");
  }
  if (message.jsonrpc !== "2.0") {
    throw new LspError(ErrorCodes.InvalidRequest, "Expected jsonrpc to be \"2.0\".");
  }
  if (typeof message.method !== "string") {
    throw new LspError(ErrorCodes.InvalidRequest, "Expected method to be a string.");
  }
  if (
    hasRequestId(message) &&
    message.id !== null &&
    typeof message.id !== "string" &&
    typeof message.id !== "number"
  ) {
    throw new LspError(ErrorCodes.InvalidRequest, "Expected id to be a string, number, or null.");
  }
}

function lineAt(text, line) {
  return (text || "").split(/\r?\n/)[line] || "";
}

function tokenAt(line, character) {
  const left = line.slice(0, character + 1);
  const right = line.slice(character + 1);
  const startMatch = left.match(/[#%$&*@]?[A-Za-z0-9_*]*$/);
  const endMatch = right.match(/^[A-Za-z0-9_*]*/);
  return `${startMatch ? startMatch[0] : ""}${endMatch ? endMatch[0] : ""}`;
}

function completionPrefix(line, character) {
  const prefix = line.slice(0, character).match(/[#%$&*@]?[A-Za-z0-9_*]*$/);
  return prefix ? prefix[0].toLowerCase() : "";
}

function dynamicCompletionItems(prefix) {
  const sigil = prefix[0];
  if (!"$&*@".includes(sigil)) {
    return [];
  }

  const wantedKind = sigil === "@" ? "function" : "variable";
  const seen = new Set();
  const items = [];

  for (const document of parseOpenDocuments()) {
    for (const symbol of document.ast.symbols) {
      if (symbol.kind !== wantedKind || !validRenameName(symbol.name) || seen.has(symbol.name)) {
        continue;
      }

      seen.add(symbol.name);
      items.push({
        label: `${sigil}${symbol.name}`,
        kind: sigil === "@" ? CompletionItemKind.Function : CompletionItemKind.Variable,
        insertText: `${sigil}${symbol.name}`,
        insertTextFormat: 1,
        detail: sigil === "@" ? "TinTin++ function" : "TinTin++ variable",
        documentation: {
          kind: "markdown",
          value:
            sigil === "@"
              ? `Function defined or referenced in an open TinTin++ document: \`${symbol.name}\`.`
              : `Variable defined or referenced in an open TinTin++ document: \`${symbol.name}\`.`,
        },
      });
    }
  }

  return items;
}

function completion(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  const text = documents.get(uri) || "";
  const line = lineAt(text, position.line);
  const prefix = completionPrefix(line, position.character);
  const items = [...dynamicCompletionItems(prefix), ...completionItems];

  if (!prefix) {
    return items;
  }

  return items.filter((item) => item.label.toLowerCase().startsWith(prefix));
}

function hover(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  const text = documents.get(uri) || "";
  const line = lineAt(text, position.line);
  const rawToken = tokenAt(line, position.character);
  const token = rawToken.startsWith("#") ? rawToken.toLowerCase() : rawToken;

  if (/^\$[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable**\n\nSubstitutes the value of a variable.",
      },
    };
  }

  if (/^&[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable metadata**\n\nSubstitutes variable metadata where supported by TinTin++.",
      },
    };
  }

  if (/^\*[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ variable index substitution**\n\nSubstitutes variable index data where supported by TinTin++.",
      },
    };
  }

  if (/^@[A-Za-z_][A-Za-z0-9_]*$/.test(rawToken)) {
    return {
      contents: {
        kind: "markdown",
        value: "**TinTin++ function**\n\nSubstitutes the result of a TinTin++ function.",
      },
    };
  }

  const entry = hoverDocs.get(token);
  if (!entry) {
    return null;
  }

  return {
    contents: {
      kind: "markdown",
      value: `**${entry.label}**\n\n${entry.detail}\n\n${entry.documentation}`,
    },
  };
}

function lineStartsFor(text) {
  const starts = [0];
  for (let index = 0; index < text.length; index += 1) {
    if (text[index] === "\n") {
      starts.push(index + 1);
    }
  }
  return starts;
}

function positionAt(lineStarts, offset) {
  let low = 0;
  let high = lineStarts.length - 1;

  while (low <= high) {
    const middle = Math.floor((low + high) / 2);
    if (lineStarts[middle] <= offset) {
      low = middle + 1;
    } else {
      high = middle - 1;
    }
  }

  const line = Math.max(0, high);
  return { line, character: offset - lineStarts[line] };
}

function rangeFromOffsets(lineStarts, start, end) {
  return {
    start: positionAt(lineStarts, start),
    end: positionAt(lineStarts, end),
  };
}

function diagnostic(lineStarts, start, end, severity, message) {
  return {
    range: rangeFromOffsets(lineStarts, start, Math.max(start + 1, end)),
    severity,
    source: "tintin-lsp",
    message,
  };
}

function canonicalCommand(name) {
  const lower = name.toLowerCase();
  if (commandNameSet.has(lower)) {
    return lower;
  }

  const matches = commandNames.filter((command) => command.startsWith(lower));
  return matches.length === 1 ? matches[0] : null;
}

function readBareWord(text, start) {
  let end = start;
  while (end < text.length && wordPattern.test(text[end])) {
    end += 1;
  }
  return { value: text.slice(start, end), start, end };
}

function isCommandTerminator(text, index, braceDepth) {
  if (braceDepth > 0) {
    return false;
  }
  return text[index] === ";" || text[index] === "\n" || text[index] === "\r";
}

function parseArguments(text, lineStarts, start) {
  const args = [];
  const diagnostics = [];
  const braceStack = [];
  let index = start;
  let quote = null;
  let tokenStart = null;
  let tokenValue = "";
  let blockCommentStart = null;

  function flushToken(end) {
    if (tokenStart !== null) {
      const value = tokenValue.trim();
      if (value) {
        args.push({ value, start: tokenStart, end, contentStart: tokenStart, contentEnd: end });
      }
      tokenStart = null;
      tokenValue = "";
    }
  }

  while (index < text.length) {
    const char = text[index];
    const next = text[index + 1];
    const previous = text[index - 1];

    if (blockCommentStart !== null) {
      if (char === "*" && next === "/") {
        blockCommentStart = null;
        index += 2;
      } else {
        index += 1;
      }
      continue;
    }

    if (quote) {
      if (tokenStart === null) {
        tokenStart = index;
      }
      tokenValue += char;
      if (char === quote && previous !== "\\") {
        quote = null;
      }
      index += 1;
      continue;
    }

    if (char === "/" && next === "*") {
      flushToken(index);
      blockCommentStart = index;
      index += 2;
      continue;
    }

    if (char === "\"" || char === "'") {
      quote = char;
      if (tokenStart === null) {
        tokenStart = index;
      }
      tokenValue += char;
      index += 1;
      continue;
    }

    if (isCommandTerminator(text, index, braceStack.length)) {
      flushToken(index);
      break;
    }

    if (braceStack.length === 0 && /\s/.test(char)) {
      flushToken(index);
      index += 1;
      continue;
    }

    if (char === "{") {
      if (braceStack.length === 0) {
        flushToken(index);
        tokenStart = index + 1;
        tokenValue = "";
      } else if (tokenStart === null) {
        tokenStart = index;
        tokenValue += char;
      } else {
        tokenValue += char;
      }
      braceStack.push(index);
      index += 1;
      continue;
    }

    if (char === "}") {
      if (braceStack.length === 0) {
        diagnostics.push(diagnostic(lineStarts, index, index + 1, DiagnosticSeverity.Error, "Unmatched closing brace."));
        index += 1;
        continue;
      }

      braceStack.pop();
      if (braceStack.length === 0) {
        flushToken(index);
      } else {
        tokenValue += char;
      }
      index += 1;
      continue;
    }

    if (tokenStart === null) {
      tokenStart = index;
    }
    tokenValue += char;
    index += 1;
  }

  if (quote) {
    diagnostics.push(diagnostic(lineStarts, index - 1, index, DiagnosticSeverity.Error, "Unterminated quoted string."));
  }

  flushToken(index);

  if (blockCommentStart !== null) {
    diagnostics.push(diagnostic(lineStarts, blockCommentStart, text.length, DiagnosticSeverity.Error, "Unterminated block comment."));
  }

  for (const braceStart of braceStack) {
    diagnostics.push(diagnostic(lineStarts, braceStart, braceStart + 1, DiagnosticSeverity.Error, "Unmatched opening brace."));
  }

  return { args, diagnostics, end: index };
}

function addSymbol(symbols, kind, name, range, role = "reference") {
  if (!name) {
    return;
  }
  symbols.push({ kind, name, range, role });
}

function collectVariableReferences(text, lineStarts, symbols, start, end) {
  let index = start;
  let blockCommentStart = null;

  while (index < end) {
    const char = text[index];
    const next = text[index + 1];

    if (blockCommentStart !== null) {
      if (char === "*" && next === "/") {
        blockCommentStart = null;
        index += 2;
      } else {
        index += 1;
      }
      continue;
    }

    if (char === "/" && next === "*") {
      blockCommentStart = index;
      index += 2;
      continue;
    }

    if (!"$&*@".includes(char)) {
      index += 1;
      continue;
    }

    const kind = char === "@" ? "function" : "variable";
    if (text[index + 1] === "{") {
      let nameEnd = index + 2;
      while (nameEnd < end && text[nameEnd] !== "}" && text[nameEnd] !== "\n" && text[nameEnd] !== "\r") {
        nameEnd += 1;
      }
      if (nameEnd < end && text[nameEnd] === "}") {
        const name = text.slice(index + 2, nameEnd).trim();
        if (validRenameName(name)) {
          const leadingWhitespace = text.slice(index + 2, nameEnd).match(/^\s*/)[0].length;
          addSymbol(
            symbols,
            kind,
            name,
            rangeFromOffsets(lineStarts, index + 2 + leadingWhitespace, index + 2 + leadingWhitespace + name.length)
          );
        }
        index = nameEnd + 1;
        continue;
      }
    }

    if (/[A-Za-z_]/.test(text[index + 1] || "")) {
      const word = readBareWord(text, index + 1);
      addSymbol(symbols, kind, word.value, rangeFromOffsets(lineStarts, word.start, word.end));
      index = word.end;
      continue;
    }

    index += 1;
  }
}

function parseTintin(text) {
  const lineStarts = lineStartsFor(text);
  const diagnostics = [];
  const commands = [];
  const symbols = [];

  function parseRange(start, end) {
    let index = start;
    let blockCommentStart = null;

    while (index < end) {
      const char = text[index];
      const next = text[index + 1];

      if (blockCommentStart !== null) {
        if (char === "*" && next === "/") {
          blockCommentStart = null;
          index += 2;
        } else {
          index += 1;
        }
        continue;
      }

      if (char === "/" && next === "*") {
        blockCommentStart = index;
        index += 2;
        continue;
      }

      if (/\s|;/.test(char)) {
        index += 1;
        continue;
      }

      if (char !== "#") {
        const rawCommandStart = index;
        while (index < end && text[index] !== "\n" && text[index] !== ";") {
          index += 1;
        }
        collectVariableReferences(text, lineStarts, symbols, rawCommandStart, index);
        continue;
      }

      const commandStart = index;
      index += 1;

      if (/\d/.test(text[index] || "")) {
        const repeat = readBareWord(text, index);
        commands.push({
          name: `#${repeat.value}`,
          canonicalName: "repeat-count",
          range: rangeFromOffsets(lineStarts, commandStart, Math.min(repeat.end, end)),
          args: [],
        });
        index = Math.min(repeat.end, end);
        continue;
      }

      const name = readBareWord(text, index);
      if (!name.value) {
        diagnostics.push(diagnostic(lineStarts, commandStart, commandStart + 1, DiagnosticSeverity.Warning, "Expected a TinTin++ command name after #."));
        continue;
      }

      const canonicalName = canonicalCommand(name.value);
      const commandDiagnostics = [];
      if (!canonicalName) {
        commandDiagnostics.push(
          diagnostic(
            lineStarts,
            commandStart,
            name.end,
            DiagnosticSeverity.Warning,
            `Unknown or ambiguous TinTin++ command: #${name.value}.`
          )
        );
      }

      index = name.end;
      const parsedArgs = parseArguments(text.slice(0, end), lineStarts, index);
      index = parsedArgs.end;
      diagnostics.push(...commandDiagnostics, ...parsedArgs.diagnostics);

      const command = {
        name: `#${name.value}`,
        canonicalName,
        range: rangeFromOffsets(lineStarts, commandStart, name.end),
        args: parsedArgs.args,
      };
      commands.push(command);

      if (canonicalName && commandArgRules.has(canonicalName)) {
        const rule = commandArgRules.get(canonicalName);
        if (parsedArgs.args.length < rule.min) {
          diagnostics.push(diagnostic(lineStarts, commandStart, name.end, DiagnosticSeverity.Warning, rule.message));
        }
      }

      const firstArg = parsedArgs.args[0];
      if (firstArg && canonicalName && variableDefinitionCommands.has(canonicalName) && validRenameName(firstArg.value)) {
        addSymbol(symbols, "variable", firstArg.value, rangeFromOffsets(lineStarts, firstArg.start, firstArg.end), "definition");
      }
      if (firstArg && canonicalName && functionDefinitionCommands.has(canonicalName) && validRenameName(firstArg.value)) {
        addSymbol(symbols, "function", firstArg.value, rangeFromOffsets(lineStarts, firstArg.start, firstArg.end), "definition");
      }

      if (canonicalName !== "nop") {
        const commandBlockIndexes = new Set(commandBlockArgIndexes.get(canonicalName) || []);
        for (const [argIndex, arg] of parsedArgs.args.entries()) {
          if (commandBlockIndexes.has(argIndex)) {
            continue;
          }
          collectVariableReferences(text, lineStarts, symbols, arg.contentStart, arg.contentEnd);
        }
      }

      for (const bodyIndex of commandBlockArgIndexes.get(canonicalName) || []) {
        const arg = parsedArgs.args[bodyIndex];
        if (arg) {
          parseRange(arg.contentStart, arg.contentEnd);
        }
      }
    }

    if (blockCommentStart !== null) {
      diagnostics.push(diagnostic(lineStarts, blockCommentStart, end, DiagnosticSeverity.Error, "Unterminated block comment."));
    }
  }

  parseRange(0, text.length);

  return {
    type: "TintinScript",
    commands,
    diagnostics,
    symbols,
  };
}

function publishDiagnostics(uri) {
  const text = documents.get(uri);
  if (typeof text !== "string") {
    send({ jsonrpc: "2.0", method: "textDocument/publishDiagnostics", params: { uri, diagnostics: [] } });
    return;
  }

  send({
    jsonrpc: "2.0",
    method: "textDocument/publishDiagnostics",
    params: {
      uri,
      diagnostics: parseTintin(text).diagnostics,
    },
  });
}

function braceDelta(line) {
  let delta = 0;
  let quote = null;
  let inBlockComment = false;

  for (let index = 0; index < line.length; index += 1) {
    const char = line[index];
    const next = line[index + 1];
    const previous = line[index - 1];

    if (inBlockComment) {
      if (char === "*" && next === "/") {
        inBlockComment = false;
        index += 1;
      }
      continue;
    }

    if (quote) {
      if (char === quote && previous !== "\\") {
        quote = null;
      }
      continue;
    }

    if (char === "/" && next === "*") {
      inBlockComment = true;
      index += 1;
      continue;
    }

    if (char === "\"" || char === "'") {
      quote = char;
      continue;
    }

    if (char === "{") {
      delta += 1;
    } else if (char === "}") {
      delta -= 1;
    }
  }

  return delta;
}

function splitTopLevelCommands(text) {
  const lines = [];
  let start = 0;
  let braceDepth = 0;
  let quote = null;
  let inBlockComment = false;

  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];
    const next = text[index + 1];
    const previous = text[index - 1];

    if (inBlockComment) {
      if (char === "*" && next === "/") {
        inBlockComment = false;
        index += 1;
      }
      continue;
    }

    if (quote) {
      if (char === quote && previous !== "\\") {
        quote = null;
      }
      continue;
    }

    if (char === "/" && next === "*") {
      inBlockComment = true;
      index += 1;
      continue;
    }

    if (char === "\"" || char === "'") {
      quote = char;
      continue;
    }

    if (char === "{") {
      braceDepth += 1;
    } else if (char === "}") {
      braceDepth = Math.max(0, braceDepth - 1);
    }

    if ((char === ";" || char === "\n") && braceDepth === 0) {
      lines.push(text.slice(start, index));
      start = index + 1;
    }
  }

  lines.push(text.slice(start));
  return lines;
}

function formatTintin(text, tabSize) {
  if (!text) {
    return "";
  }

  const numericTabSize = Number.isFinite(tabSize) ? tabSize : 2;
  const unit = " ".repeat(Math.min(8, Math.max(1, numericTabSize)));
  const formatted = [];
  let depth = 0;

  for (const rawLine of splitTopLevelCommands(text)) {
    const trimmed = rawLine.trim();
    if (!trimmed) {
      if (formatted.length > 0 && formatted[formatted.length - 1] !== "") {
        formatted.push("");
      }
      continue;
    }

    const leadingClosers = (trimmed.match(/^}+/) || [""])[0].length;
    const lineDepth = Math.max(0, depth - leadingClosers);
    formatted.push(`${unit.repeat(lineDepth)}${trimmed}`);
    depth = Math.max(0, lineDepth + braceDelta(trimmed));
  }

  while (formatted[formatted.length - 1] === "") {
    formatted.pop();
  }

  return `${formatted.join("\n")}\n`;
}

function fullDocumentRange(text) {
  const lineStarts = lineStartsFor(text);
  return {
    start: { line: 0, character: 0 },
    end: positionAt(lineStarts, text.length),
  };
}

function formatting(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const options = requireObject(checkedParams.options, "options");
  const text = documents.get(uri) || "";
  const newText = formatTintin(text, options.tabSize);
  if (newText === text) {
    return [];
  }

  return [{ range: fullDocumentRange(text), newText }];
}

function symbolAtPosition(ast, position) {
  return ast.symbols.find((symbol) => {
    const start = symbol.range.start;
    const end = symbol.range.end;
    if (position.line < start.line || position.line > end.line) {
      return false;
    }
    if (position.line === start.line && position.character < start.character) {
      return false;
    }
    if (position.line === end.line && position.character >= end.character) {
      return false;
    }
    return true;
  });
}

function parseOpenDocuments() {
  return Array.from(documents.entries()).map(([uri, text]) => ({
    uri,
    ast: parseTintin(text),
  }));
}

function symbolKind(symbol) {
  return symbol.kind === "function" ? SymbolKind.Function : SymbolKind.Variable;
}

function documentSymbols(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);

  return ast.symbols
    .filter((symbol) => symbol.role === "definition")
    .map((symbol) => ({
      name: symbol.name,
      kind: symbolKind(symbol),
      range: symbol.range,
      selectionRange: symbol.range,
    }));
}

function workspaceSymbols(params) {
  const checkedParams = requestParams(params);
  if (typeof checkedParams.query !== "string") {
    invalidParams("Expected query to be a string.");
  }
  const query = checkedParams.query.toLowerCase();

  return parseOpenDocuments()
    .flatMap((document) =>
      document.ast.symbols
        .filter((symbol) => symbol.role === "definition" && symbol.name.toLowerCase().includes(query))
        .map((symbol) => ({
          name: symbol.name,
          kind: symbolKind(symbol),
          location: {
            uri: document.uri,
            range: symbol.range,
          },
          containerName: "TinTin++",
        }))
    );
}

function foldingRanges(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const lineStarts = lineStartsFor(text);
  const ranges = [];

  for (const command of ast.commands) {
    for (const arg of command.args) {
      const start = rangeFromOffsets(lineStarts, arg.contentStart, arg.contentStart).start;
      const end = rangeFromOffsets(lineStarts, arg.contentEnd, arg.contentEnd).end;
      if (start.line < end.line) {
        ranges.push({
          startLine: start.line,
          startCharacter: start.character,
          endLine: end.line,
          endCharacter: end.character,
        });
      }
    }
  }

  return ranges;
}

function targetUriForPathArgument(documentUri, value) {
  if (!documentUri.startsWith("file://")) {
    return null;
  }

  const normalizedValue = normalizeStaticPathArgument(value);
  if (!normalizedValue) {
    return null;
  }

  try {
    const documentDirectory = path.dirname(fileURLToPath(documentUri));
    const resolvedPath = path.isAbsolute(normalizedValue)
      ? normalizedValue
      : path.resolve(documentDirectory, normalizedValue);
    return pathToFileURL(resolvedPath).href;
  } catch {
    return null;
  }
}

function normalizeStaticPathArgument(value) {
  if (typeof value !== "string") {
    return "";
  }

  const trimmed = value.trim();
  if (trimmed.length < 2) {
    return trimmed;
  }

  const quote = trimmed[0];
  if ((quote === "\"" || quote === "'") && trimmed[trimmed.length - 1] === quote) {
    return trimmed.slice(1, -1);
  }

  return trimmed;
}

function documentLinks(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const lineStarts = lineStartsFor(text);
  const links = [];

  for (const command of ast.commands) {
    const argIndexes = fileArgIndexes.get(command.canonicalName);
    if (!argIndexes) {
      continue;
    }

    for (const argIndex of argIndexes) {
      const arg = command.args[argIndex];
      if (!arg) {
        continue;
      }

      const target = targetUriForPathArgument(uri, arg.value);
      if (target) {
        links.push({
          range: rangeFromOffsets(lineStarts, arg.start, arg.end),
          target,
          tooltip: "Open TinTin++ script file",
        });
      }
    }
  }

  return links;
}

function editRangeIntersects(requestRange, editRange) {
  const startsBeforeEnd =
    requestRange.start.line < editRange.end.line ||
    (requestRange.start.line === editRange.end.line && requestRange.start.character <= editRange.end.character);
  const endsAfterStart =
    requestRange.end.line > editRange.start.line ||
    (requestRange.end.line === editRange.start.line && requestRange.end.character >= editRange.start.character);
  return startsBeforeEnd && endsAfterStart;
}

function levenshteinDistance(left, right) {
  const previous = Array.from({ length: right.length + 1 }, (_, index) => index);
  const current = Array.from({ length: right.length + 1 }, () => 0);

  for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {
    current[0] = leftIndex;
    for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {
      const cost = left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1;
      current[rightIndex] = Math.min(
        current[rightIndex - 1] + 1,
        previous[rightIndex] + 1,
        previous[rightIndex - 1] + cost
      );
    }
    for (let index = 0; index < previous.length; index += 1) {
      previous[index] = current[index];
    }
  }

  return previous[right.length];
}

function commandSuggestions(commandName) {
  const lowerName = commandName.toLowerCase();
  const prefixMatches = commandNames.filter((name) => name.startsWith(lowerName)).slice(0, 5);
  if (prefixMatches.length > 0) {
    return prefixMatches;
  }

  return commandNames
    .map((name) => ({ name, distance: levenshteinDistance(lowerName, name) }))
    .filter((candidate) => candidate.distance <= Math.max(2, Math.floor(lowerName.length / 3)))
    .sort((left, right) => left.distance - right.distance || left.name.localeCompare(right.name))
    .slice(0, 5)
    .map((candidate) => candidate.name);
}

function codeActions(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const range = requireObject(checkedParams.range, "range");
  const start = requirePosition({ position: range.start });
  const end = requirePosition({ position: range.end });
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const actions = [];

  for (const diagnosticItem of ast.diagnostics) {
    if (!diagnosticItem.message.startsWith("Unknown or ambiguous TinTin++ command: #")) {
      continue;
    }
    if (!editRangeIntersects({ start, end }, diagnosticItem.range)) {
      continue;
    }

    const commandName = diagnosticItem.message
      .slice("Unknown or ambiguous TinTin++ command: #".length)
      .replace(/\.$/, "");

    for (const suggestion of commandSuggestions(commandName)) {
      actions.push({
        title: `Replace with #${suggestion}`,
        kind: CodeActionKind.QuickFix,
        diagnostics: [diagnosticItem],
        edit: {
          changes: {
            [uri]: [
              {
                range: diagnosticItem.range,
                newText: `#${suggestion}`,
              },
            ],
          },
        },
      });
    }
  }

  return actions;
}

function references(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  const context = requireObject(checkedParams.context, "context");
  if (typeof context.includeDeclaration !== "boolean") {
    invalidParams("Expected context.includeDeclaration to be a boolean.");
  }
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const symbol = symbolAtPosition(ast, position);
  if (!symbol) {
    return [];
  }

  return parseOpenDocuments()
    .flatMap((document) =>
      document.ast.symbols
        .filter(
          (candidate) =>
            candidate.kind === symbol.kind &&
            candidate.name === symbol.name &&
            (context.includeDeclaration || candidate.role !== "definition")
        )
        .map((candidate) => ({ uri: document.uri, range: candidate.range }))
    );
}

function definition(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const symbol = symbolAtPosition(ast, position);
  if (!symbol) {
    return null;
  }

  const definitions = parseOpenDocuments()
    .flatMap((document) =>
      document.ast.symbols
        .filter(
          (candidate) =>
            candidate.role === "definition" && candidate.kind === symbol.kind && candidate.name === symbol.name
        )
        .map((candidate) => ({ uri: document.uri, range: candidate.range }))
    );

  return definitions.length > 0 ? definitions : null;
}

function validRenameName(name) {
  return typeof name === "string" && /^[A-Za-z_][A-Za-z0-9_]*$/.test(name);
}

function prepareRename(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const symbol = symbolAtPosition(ast, position);
  if (!symbol) {
    return null;
  }
  return {
    range: symbol.range,
    placeholder: symbol.name,
  };
}

function rename(params) {
  const checkedParams = requestParams(params);
  const uri = requireTextDocumentUri(checkedParams);
  const position = requirePosition(checkedParams);
  if (typeof checkedParams.newName !== "string") {
    invalidParams("Expected newName to be a string.");
  }
  const text = documents.get(uri) || "";
  const ast = parseTintin(text);
  const symbol = symbolAtPosition(ast, position);
  if (!symbol) {
    return null;
  }
  if (!validRenameName(checkedParams.newName)) {
    return null;
  }

  const changes = {};
  for (const document of parseOpenDocuments()) {
    const edits = document.ast.symbols
      .filter((candidate) => candidate.kind === symbol.kind && candidate.name === symbol.name)
      .map((candidate) => ({ range: candidate.range, newText: checkedParams.newName }));
    if (edits.length > 0) {
      changes[document.uri] = edits;
    }
  }

  return {
    changes,
  };
}

function handleMessage(message) {
  if (message.method === "initialize") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, {
      capabilities: {
        textDocumentSync: 1,
        completionProvider: {
          triggerCharacters: ["#", "%", "$", "&", "*", "@"],
        },
        hoverProvider: true,
        documentFormattingProvider: true,
        documentSymbolProvider: true,
        workspaceSymbolProvider: true,
        foldingRangeProvider: true,
        documentLinkProvider: {
          resolveProvider: false,
        },
        codeActionProvider: {
          codeActionKinds: [CodeActionKind.QuickFix],
        },
        referencesProvider: true,
        definitionProvider: true,
        renameProvider: {
          prepareProvider: true,
        },
      },
      serverInfo: {
        name: "tintin-lsp",
        version: packageMetadata.version,
      },
    });
    return;
  }

  if (message.method === "shutdown") {
    shutdownRequested = true;
    if (hasRequestId(message)) {
      respond(message.id, null);
    }
    return;
  }

  if (message.method === "exit") {
    process.exit(shutdownRequested ? 0 : 1);
  }

  if (message.method === "textDocument/didOpen") {
    const params = requestParams(message.params);
    const textDocument = requireObject(params.textDocument, "textDocument");
    const uri = requireString(textDocument.uri, "textDocument.uri");
    const text = requireString(textDocument.text, "textDocument.text");
    documents.set(uri, text);
    publishDiagnostics(uri);
    return;
  }

  if (message.method === "textDocument/didChange") {
    const params = requestParams(message.params);
    const uri = requireTextDocumentUri(params);
    if (!Array.isArray(params.contentChanges)) {
      invalidParams("Expected contentChanges to be an array.");
    }
    const change = params.contentChanges[0];
    if (change && typeof change.text === "string") {
      documents.set(uri, change.text);
      publishDiagnostics(uri);
    }
    return;
  }

  if (message.method === "textDocument/didClose") {
    const params = requestParams(message.params);
    const uri = requireTextDocumentUri(params);
    documents.delete(uri);
    publishDiagnostics(uri);
    return;
  }

  if (message.method === "textDocument/completion") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, completion(message.params));
    return;
  }

  if (message.method === "textDocument/hover") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, hover(message.params));
    return;
  }

  if (message.method === "textDocument/formatting") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, formatting(message.params));
    return;
  }

  if (message.method === "textDocument/documentSymbol") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, documentSymbols(message.params));
    return;
  }

  if (message.method === "workspace/symbol") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, workspaceSymbols(message.params));
    return;
  }

  if (message.method === "textDocument/foldingRange") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, foldingRanges(message.params));
    return;
  }

  if (message.method === "textDocument/documentLink") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, documentLinks(message.params));
    return;
  }

  if (message.method === "textDocument/codeAction") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, codeActions(message.params));
    return;
  }

  if (message.method === "textDocument/references") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, references(message.params));
    return;
  }

  if (message.method === "textDocument/definition") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, definition(message.params));
    return;
  }

  if (message.method === "textDocument/prepareRename") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, prepareRename(message.params));
    return;
  }

  if (message.method === "textDocument/rename") {
    if (!hasRequestId(message)) {
      return;
    }
    respond(message.id, rename(message.params));
    return;
  }

  if (hasRequestId(message)) {
    respondError(message.id, ErrorCodes.MethodNotFound, `Method not found: ${message.method}`);
  }
}

function parseBuffer() {
  while (true) {
    const headerEnd = buffer.indexOf("\r\n\r\n");
    if (headerEnd === -1) {
      return;
    }

    const header = buffer.slice(0, headerEnd).toString("utf8");
    const match = header.match(/Content-Length:\s*(\d+)/i);
    if (!match) {
      buffer = buffer.slice(headerEnd + 4);
      continue;
    }

    const length = Number(match[1]);
    const bodyStart = headerEnd + 4;
    const bodyEnd = bodyStart + length;
    if (buffer.length < bodyEnd) {
      return;
    }

    const body = buffer.slice(bodyStart, bodyEnd).toString("utf8");
    buffer = buffer.slice(bodyEnd);

    let message;
    try {
      message = JSON.parse(body);
    } catch (error) {
      respondError(null, ErrorCodes.ParseError, error instanceof Error ? error.message : String(error));
      continue;
    }

    try {
      validateJsonRpcEnvelope(message);
      handleMessage(message);
    } catch (error) {
      const validId =
        message &&
        typeof message === "object" &&
        hasRequestId(message) &&
        (message.id === null || typeof message.id === "string" || typeof message.id === "number");
      const shouldRespond = message && typeof message === "object" && hasRequestId(message);
      const id = validId ? message.id : null;
      const code = error instanceof LspError ? error.code : ErrorCodes.InternalError;
      const messageText = error instanceof Error ? error.message : String(error);
      if (shouldRespond) {
        respondError(id, code, messageText);
      }
    }
  }
}

process.stdin.on("data", (chunk) => {
  buffer = Buffer.concat([buffer, chunk]);
  parseBuffer();
});

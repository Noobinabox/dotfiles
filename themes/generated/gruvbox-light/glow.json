{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#3c3836",
    "background_color": "#fbf1c7",
    "margin": 2
  },
  "block_quote": {
    "color": "#fbf1c7",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#458588",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#fbf1c7",
    "background_color": "#458588",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#b16286"
  },
  "h3": {
    "prefix": "### ",
    "color": "#689d6a"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#98971a"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#d79921"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#cc241d",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#b16286"
  },
  "strong": {
    "bold": true,
    "color": "#3c3836"
  },
  "hr": {
    "color": "#7c6f64",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#98971a",
    "underline": true
  },
  "link_text": {
    "color": "#689d6a",
    "bold": true
  },
  "image": {
    "color": "#d65d0e",
    "underline": true
  },
  "image_text": {
    "color": "#928374",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#d65d0e",
    "background_color": "#f2e5bc"
  },
  "code_block": {
    "color": "#3c3836",
    "background_color": "#ebdbb2",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#3c3836"
      },
      "error": {
        "color": "#3c3836",
        "background_color": "#cc241d"
      },
      "comment": {
        "color": "#928374",
        "italic": true
      },
      "comment_preproc": {
        "color": "#d79921"
      },
      "keyword": {
        "color": "#b16286"
      },
      "keyword_reserved": {
        "color": "#cc241d"
      },
      "keyword_namespace": {
        "color": "#458588"
      },
      "keyword_type": {
        "color": "#689d6a"
      },
      "operator": {
        "color": "#689d6a"
      },
      "punctuation": {
        "color": "#689d6a"
      },
      "name": {
        "color": "#3c3836"
      },
      "name_builtin": {
        "color": "#689d6a"
      },
      "name_tag": {
        "color": "#cc241d"
      },
      "name_attribute": {
        "color": "#458588"
      },
      "name_class": {
        "color": "#98971a",
        "bold": true
      },
      "name_constant": {
        "color": "#d65d0e"
      },
      "name_decorator": {
        "color": "#d79921"
      },
      "name_exception": {
        "color": "#cc241d"
      },
      "name_function": {
        "color": "#458588"
      },
      "name_other": {},
      "literal": {
        "color": "#d65d0e"
      },
      "literal_number": {
        "color": "#d65d0e"
      },
      "literal_date": {
        "color": "#98971a"
      },
      "literal_string": {
        "color": "#98971a"
      },
      "literal_string_escape": {
        "color": "#689d6a"
      },
      "generic_deleted": {
        "color": "#cc241d"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#98971a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#928374"
      },
      "background": {
        "background_color": "#ebdbb2"
      }
    }
  },
  "table": {
    "color": "#3c3836"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#458588",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#928374"
  },
  "html_span": {
    "color": "#928374"
  }
}

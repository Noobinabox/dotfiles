#!/usr/bin/env node
"use strict";

const path = require("node:path");
const fs = require("node:fs");
const { spawn } = require("node:child_process");

const wrapperPath = fs.realpathSync(__filename);
const packageBin = path.resolve(path.dirname(wrapperPath), "../../../tintin-lsp/bin/tintin-lsp");
const child = spawn(process.execPath, [packageBin], {
  stdio: "inherit",
});

const signalExitCodes = {
  SIGHUP: 129,
  SIGINT: 130,
  SIGTERM: 143,
};
let forwardedSignal = null;

for (const signal of Object.keys(signalExitCodes)) {
  process.once(signal, () => {
    forwardedSignal = signal;
    if (!child.killed) {
      child.kill(signal);
    }
  });
}

child.on("exit", (code, signal) => {
  if (forwardedSignal) {
    process.exit(signalExitCodes[forwardedSignal]);
  }

  if (signal) {
    process.kill(process.pid, signal);
    return;
  }

  process.exit(code === null ? 1 : code);
});

child.on("error", (error) => {
  console.error(`Unable to start tintin-lsp package binary: ${error.message}`);
  process.exit(1);
});

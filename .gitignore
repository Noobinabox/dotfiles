.local/
!tools/.local/
tools/.local/*
!tools/.local/bin/
tools/.local/bin/*
!tools/.local/bin/tintin-lsp
*.log
*.tmp
*.bak
*.swp
*.swo
__pycache__/
*.py[cod]

# Secret material must be encrypted before it is tracked.
secrets/*
!secrets/*.gpg
!secrets/README.md
secrets/.encrypt.*/

# Runtime auth/state that should never be imported directly.
**/auth.db
**/auth.db-*
**/token-cache.json
**/credentials.json
**/hosts.yml
**/known_hosts
**/id_*
**/.zsh_history
**/.bash_history

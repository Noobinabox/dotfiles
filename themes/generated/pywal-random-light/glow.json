{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#695d69",
    "background_color": "#f7f3f7",
    "margin": 2
  },
  "block_quote": {
    "color": "#695d69",
    "indent": 1,
    "indent_token": "| "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#516aec",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f7f3f7",
    "background_color": "#516aec",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#7b59c0"
  },
  "h3": {
    "prefix": "### ",
    "color": "#159393"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#918b3b"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#bb8a35"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#ca402b",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#7b59c0"
  },
  "strong": {
    "bold": true,
    "color": "#695d69"
  },
  "hr": {
    "color": "#9e8f9e",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#918b3b",
    "underline": true
  },
  "link_text": {
    "color": "#159393",
    "bold": true
  },
  "image": {
    "color": "#bb8a35",
    "underline": true
  },
  "image_text": {
    "color": "#9e8f9e",
    "format": "Image: {{.text}} ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#bb8a35",
    "background_color": "#f7f3f7"
  },
  "code_block": {
    "color": "#695d69",
    "background_color": "#f7f3f7",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#695d69"
      },
      "error": {
        "color": "#695d69",
        "background_color": "#ca402b"
      },
      "comment": {
        "color": "#9e8f9e",
        "italic": true
      },
      "comment_preproc": {
        "color": "#bb8a35"
      },
      "keyword": {
        "color": "#7b59c0"
      },
      "keyword_reserved": {
        "color": "#ca402b"
      },
      "keyword_namespace": {
        "color": "#516aec"
      },
      "keyword_type": {
        "color": "#159393"
      },
      "operator": {
        "color": "#159393"
      },
      "punctuation": {
        "color": "#159393"
      },
      "name": {
        "color": "#695d69"
      },
      "name_builtin": {
        "color": "#159393"
      },
      "name_tag": {
        "color": "#ca402b"
      },
      "name_attribute": {
        "color": "#516aec"
      },
      "name_class": {
        "color": "#918b3b",
        "bold": true
      },
      "name_constant": {
        "color": "#bb8a35"
      },
      "name_decorator": {
        "color": "#bb8a35"
      },
      "name_exception": {
        "color": "#ca402b"
      },
      "name_function": {
        "color": "#516aec"
      },
      "name_other": {},
      "literal": {
        "color": "#bb8a35"
      },
      "literal_number": {
        "color": "#bb8a35"
      },
      "literal_date": {
        "color": "#918b3b"
      },
      "literal_string": {
        "color": "#918b3b"
      },
      "literal_string_escape": {
        "color": "#159393"
      },
      "generic_deleted": {
        "color": "#ca402b"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#918b3b"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#9e8f9e"
      },
      "background": {
        "background_color": "#f7f3f7"
      }
    }
  },
  "table": {
    "color": "#695d69"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#516aec",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {
    "color": "#9e8f9e"
  },
  "html_span": {
    "color": "#9e8f9e"
  }
}
